<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Meridian Transit — Operations</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

  :root{
    --bg:#0A0E13;
    --surface:#111820;
    --surface-2:#161F2A;
    --border:#232E3B;
    --border-soft:#1B2531;
    --text:#E8EDF3;
    --text-dim:#8A96A5;
    --text-faint:#5A6675;
    --teal:#2FDFC4;
    --teal-dim:#173A35;
    --amber:#F4B740;
    --amber-dim:#3A2E12;
    --red:#FF6B5E;
    --red-dim:#3A1815;
    --blue:#5FA8FF;
    --rail-w:76px;
    --font-display:'Space Grotesk', sans-serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'IBM Plex Mono', monospace;
  }

  *{ box-sizing:border-box; margin:0; padding:0; }

  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--font-body);
    font-size:14px;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }

  a{ color:inherit; text-decoration:none; }
  button{ font-family:inherit; cursor:pointer; }

  :focus-visible{
    outline:2px solid var(--teal);
    outline-offset:2px;
    border-radius:4px;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation:none !important; transition:none !important; }
  }

  /* ============ APP SHELL ============ */
  .app{
    display:grid;
    grid-template-columns: var(--rail-w) 1fr;
    grid-template-rows: 64px 1fr;
    grid-template-areas:
      "rail topbar"
      "rail main";
    min-height:100vh;
  }

  /* ============ TRANSIT-LINE RAIL NAV ============ */
  .rail{
    grid-area: rail;
    background:var(--surface);
    border-right:1px solid var(--border);
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:20px 0 16px;
    position:relative;
  }

  .rail-mark{
    width:34px; height:34px;
    border-radius:9px;
    background:linear-gradient(155deg, var(--teal), var(--blue));
    display:flex; align-items:center; justify-content:center;
    font-family:var(--font-display);
    font-weight:700;
    font-size:15px;
    color:#04110E;
    margin-bottom:28px;
    flex-shrink:0;
  }

  .rail-line{
    position:relative;
    flex:1;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:2px;
  }

  .rail-line::before{
    content:"";
    position:absolute;
    top:4px; bottom:4px;
    width:2px;
    background:var(--border);
    z-index:0;
  }

  .rail-stop{
    position:relative;
    z-index:1;
    width:100%;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:6px;
    padding:11px 0;
    background:var(--surface);
    color:var(--text-faint);
    border:none;
  }

  .rail-stop .dot{
    width:9px; height:9px;
    border-radius:50%;
    background:var(--border);
    border:2px solid var(--surface);
    box-shadow:0 0 0 1px var(--border);
    transition:background .15s, box-shadow .15s;
  }

  .rail-stop svg{ width:18px; height:18px; opacity:.75; }

  .rail-stop:hover{ color:var(--text-dim); }
  .rail-stop:hover .dot{ background:var(--text-dim); box-shadow:0 0 0 1px var(--text-dim); }

  .rail-stop.active{ color:var(--teal); }
  .rail-stop.active .dot{
    background:var(--teal);
    box-shadow:0 0 0 3px var(--teal-dim);
  }
  .rail-stop.active svg{ opacity:1; }

  .rail-stop.alert .dot{ background:var(--red); box-shadow:0 0 0 3px var(--red-dim); }

  /* ============ TOPBAR ============ */
  .topbar{
    grid-area: topbar;
    background:var(--surface);
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 24px;
    gap:20px;
  }

  .topbar-title h1{
    font-family:var(--font-display);
    font-size:16px;
    font-weight:600;
    letter-spacing:.02em;
  }
  .topbar-title p{
    font-size:12px;
    color:var(--text-faint);
    margin-top:1px;
  }

  .topbar-right{ display:flex; align-items:center; gap:18px; }

  .system-pill{
    display:flex; align-items:center; gap:8px;
    background:var(--teal-dim);
    color:var(--teal);
    border:1px solid #1F4E46;
    padding:6px 12px;
    border-radius:100px;
    font-size:12px;
    font-weight:500;
  }
  .system-pill .pulse{
    width:6px; height:6px; border-radius:50%; background:var(--teal);
    animation:pulse 2s infinite;
  }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:.35;} }

  .clock{
    font-family:var(--font-mono);
    font-size:13px;
    color:var(--text-dim);
    min-width:78px;
    text-align:right;
  }

  .avatar{
    width:32px; height:32px;
    border-radius:8px;
    background:var(--surface-2);
    border:1px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    font-family:var(--font-mono);
    font-size:12px;
    color:var(--text-dim);
  }

  .nav-toggle{
    display:none;
    background:var(--surface-2);
    border:1px solid var(--border);
    border-radius:7px;
    width:34px; height:34px;
    align-items:center;
    justify-content:center;
    color:var(--text-dim);
  }
  .nav-toggle svg{ width:16px; height:16px; }

  /* ============ MAIN / RESPONSIVE GRID ============ */
  .main{
    grid-area: main;
    padding:24px;
    overflow-x:hidden;
  }

  .dash-grid{
    display:grid;
    grid-template-columns: repeat(12, 1fr);
    gap:18px;
    grid-template-areas:
      "kpi1 kpi1 kpi1 kpi2 kpi2 kpi2 kpi3 kpi3 kpi3 kpi4 kpi4 kpi4"
      "routes routes routes routes routes routes routes routes alerts alerts alerts alerts"
      "ridership ridership ridership ridership ridership ridership fleet fleet fleet fleet fleet fleet";
  }

  .card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:12px;
    padding:18px 20px;
    min-width:0;
  }

  .card-head{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    margin-bottom:14px;
  }
  .card-head h2{
    font-family:var(--font-display);
    font-size:13px;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:.06em;
    color:var(--text-dim);
  }
  .card-head .card-sub{ font-size:12px; color:var(--text-faint); }

  /* KPI cards */
  .kpi{ display:flex; flex-direction:column; gap:6px; }
  .kpi .label{ font-size:12px; color:var(--text-faint); text-transform:uppercase; letter-spacing:.05em; }
  .kpi .value{ font-family:var(--font-mono); font-size:28px; font-weight:500; }
  .kpi .delta{ font-size:12px; display:flex; align-items:center; gap:4px; }
  .kpi .delta.up{ color:var(--teal); }
  .kpi .delta.down{ color:var(--red); }
  .kpi .delta.flat{ color:var(--text-faint); }

  #kpi1{ grid-area:kpi1; }
  #kpi2{ grid-area:kpi2; }
  #kpi3{ grid-area:kpi3; }
  #kpi4{ grid-area:kpi4; }
  #routes{ grid-area:routes; }
  #alerts{ grid-area:alerts; }
  #ridership{ grid-area:ridership; }
  #fleet{ grid-area:fleet; }

  /* Route status board */
  .route-table{ width:100%; border-collapse:collapse; }
  .route-table th{
    text-align:left;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.05em;
    color:var(--text-faint);
    font-weight:500;
    padding:0 10px 10px;
    border-bottom:1px solid var(--border-soft);
  }
  .route-table td{
    padding:11px 10px;
    border-bottom:1px solid var(--border-soft);
    font-size:13px;
    vertical-align:middle;
  }
  .route-table tr:last-child td{ border-bottom:none; }
  .route-table tr:hover td{ background:var(--surface-2); }

  .line-chip{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:26px;
    height:22px;
    padding:0 6px;
    border-radius:6px;
    font-family:var(--font-mono);
    font-size:12px;
    font-weight:500;
    background:var(--surface-2);
    border:1px solid var(--border);
  }

  .status-dot{ display:inline-flex; align-items:center; gap:7px; font-size:13px; }
  .status-dot::before{
    content:"";
    width:7px; height:7px;
    border-radius:50%;
    flex-shrink:0;
  }
  .status-dot.ontime::before{ background:var(--teal); }
  .status-dot.minor::before{ background:var(--amber); }
  .status-dot.delayed::before{ background:var(--red); }

  .mono{ font-family:var(--font-mono); color:var(--text-dim); }

  /* Alerts feed */
  .alert-list{ display:flex; flex-direction:column; gap:2px; }
  .alert-item{
    display:flex;
    gap:12px;
    padding:11px 0;
    border-bottom:1px solid var(--border-soft);
  }
  .alert-item:last-child{ border-bottom:none; padding-bottom:0; }
  .sev-bar{ width:3px; border-radius:3px; flex-shrink:0; }
  .sev-bar.critical{ background:var(--red); }
  .sev-bar.warning{ background:var(--amber); }
  .sev-bar.info{ background:var(--blue); }
  .alert-body{ flex:1; min-width:0; }
  .alert-top{ display:flex; justify-content:space-between; gap:8px; margin-bottom:3px; }
  .alert-sev{
    font-size:10px;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:.06em;
  }
  .alert-sev.critical{ color:var(--red); }
  .alert-sev.warning{ color:var(--amber); }
  .alert-sev.info{ color:var(--blue); }
  .alert-time{ font-family:var(--font-mono); font-size:11px; color:var(--text-faint); flex-shrink:0; }
  .alert-desc{ font-size:12.5px; color:var(--text-dim); line-height:1.45; }

  /* Ridership bar chart */
  .bars{
    display:flex;
    align-items:flex-end;
    gap:6px;
    height:130px;
    padding-top:10px;
  }
  .bar-col{ flex:1; display:flex; flex-direction:column; align-items:center; gap:8px; height:100%; justify-content:flex-end; }
  .bar{
    width:100%;
    max-width:22px;
    border-radius:3px 3px 0 0;
    background:linear-gradient(180deg, var(--teal), #1B7A6C);
  }
  .bar-col span{ font-size:10px; color:var(--text-faint); font-family:var(--font-mono); }

  /* Fleet status */
  .fleet-summary{ display:flex; gap:18px; margin-bottom:16px; }
  .fleet-stat .num{ font-family:var(--font-mono); font-size:20px; }
  .fleet-stat .lbl{ font-size:11px; color:var(--text-faint); text-transform:uppercase; letter-spacing:.04em; }
  .fleet-stat.in .num{ color:var(--teal); }
  .fleet-stat.maint .num{ color:var(--amber); }
  .fleet-stat.out .num{ color:var(--red); }

  .fleet-grid{
    display:grid;
    grid-template-columns:repeat(15, 1fr);
    gap:5px;
  }
  .veh{
    aspect-ratio:1;
    border-radius:3px;
    background:var(--teal);
    opacity:.85;
  }
  .veh.maint{ background:var(--amber); }
  .veh.out{ background:var(--red); }
  .veh.idle{ background:var(--border); }

  /* ============ RESPONSIVE BREAKPOINTS ============ */
  @media (max-width: 1100px){
    .dash-grid{
      grid-template-columns: repeat(6, 1fr);
      grid-template-areas:
        "kpi1 kpi1 kpi1 kpi2 kpi2 kpi2"
        "kpi3 kpi3 kpi3 kpi4 kpi4 kpi4"
        "routes routes routes routes routes routes"
        "alerts alerts alerts alerts alerts alerts"
        "ridership ridership ridership fleet fleet fleet";
    }
  }

  @media (max-width: 860px){
    .app{
      grid-template-columns: 1fr;
      grid-template-rows: 60px auto 1fr;
      grid-template-areas:
        "topbar"
        "rail"
        "main";
    }
    .rail{
      flex-direction:row;
      border-right:none;
      border-bottom:1px solid var(--border);
      padding:10px 14px;
      overflow-x:auto;
      gap:6px;
    }
    .rail-mark{ margin-bottom:0; margin-right:10px; }
    .rail-line{ flex-direction:row; gap:4px; }
    .rail-line::before{ top:auto; bottom:auto; left:4px; right:4px; height:2px; width:auto; }
    .rail-stop{ flex-direction:row; width:auto; padding:8px 12px; border-radius:8px; }
    .rail-stop .dot{ display:none; }
    .rail-stop span.rail-label{ display:inline; }
    .nav-toggle{ display:none; }
  }

  @media (max-width: 640px){
    .dash-grid{
      grid-template-columns: 1fr;
      grid-template-areas:
        "kpi1" "kpi2" "kpi3" "kpi4" "routes" "alerts" "ridership" "fleet";
    }
    .main{ padding:16px; }
    .topbar{ padding:0 16px; }
    .route-table thead{ display:none; }
    .route-table, .route-table tbody, .route-table tr, .route-table td{ display:block; width:100%; }
    .route-table tr{
      border:1px solid var(--border-soft);
      border-radius:10px;
      margin-bottom:10px;
      padding:6px 4px;
    }
    .route-table td{
      display:flex;
      justify-content:space-between;
      align-items:center;
      border-bottom:1px solid var(--border-soft);
      padding:8px 10px;
    }
    .route-table td:last-child{ border-bottom:none; }
    .route-table td::before{
      content:attr(data-label);
      font-size:10px;
      text-transform:uppercase;
      letter-spacing:.05em;
      color:var(--text-faint);
    }
    .fleet-grid{ grid-template-columns:repeat(10, 1fr); }
  }

  .rail-label{ display:none; font-size:11px; font-weight:500; }
</style>
</head>
<body>

<div class="app">

  <!-- RAIL NAV -->
  <nav class="rail" aria-label="Primary">
    <div class="rail-mark">M</div>
    <div class="rail-line">
      <button class="rail-stop active" aria-current="page">
        <span class="dot"></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        <span class="rail-label">Overview</span>
      </button>
      <button class="rail-stop">
        <span class="dot"></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 17V9a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="16.5" cy="17.5" r="1.5"/><path d="M4 13h16"/></svg>
        <span class="rail-label">Routes</span>
      </button>
      <button class="rail-stop">
        <span class="dot"></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12h4l2-5h6l2 5h4"/><rect x="3" y="12" width="18" height="5" rx="1.5"/><circle cx="8" cy="19.5" r="1.5"/><circle cx="16" cy="19.5" r="1.5"/></svg>
        <span class="rail-label">Fleet</span>
      </button>
      <button class="rail-stop alert">
        <span class="dot"></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 2 20h20L12 3Z"/><path d="M12 10v4"/><circle cx="12" cy="17" r=".5" fill="currentColor"/></svg>
        <span class="rail-label">Alerts</span>
      </button>
      <button class="rail-stop">
        <span class="dot"></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 20V10M9 20V4M15 20v-7M21 20V8"/></svg>
        <span class="rail-label">Ridership</span>
      </button>
      <button class="rail-stop">
        <span class="dot"></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 0 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 0 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3a2 2 0 0 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.55 1H21a2 2 0 0 1 0 4h-.09a1.7 1.7 0 0 0-1.51 1Z"/></svg>
        <span class="rail-label">Settings</span>
      </button>
    </div>
  </nav>

  <!-- TOPBAR -->
  <header class="topbar">
    <div class="topbar-title">
      <h1>Operations — System Overview</h1>
      <p>Meridian Transit · Control Room</p>
    </div>
    <div class="topbar-right">
      <div class="system-pill"><span class="pulse"></span> 2 Critical Alerts</div>
      <div class="clock" id="clock" aria-live="off">--:--:--</div>
      <div class="avatar">JD</div>
      <button class="nav-toggle" aria-label="Toggle navigation">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </header>

  <!-- MAIN -->
  <main class="main">
    <div class="dash-grid">

      <div class="card kpi" id="kpi1">
        <span class="label">On-Time Performance</span>
        <span class="value">94.2%</span>
        <span class="delta up">▲ 1.8 pts vs last week</span>
      </div>

      <div class="card kpi" id="kpi2">
        <span class="label">Active Vehicles</span>
        <span class="value">142<span style="color:var(--text-faint); font-size:16px;"> / 150</span></span>
        <span class="delta flat">8 in scheduled maintenance</span>
      </div>

      <div class="card kpi" id="kpi3">
        <span class="label">Average Delay</span>
        <span class="value">3.4<span style="color:var(--text-faint); font-size:16px;"> min</span></span>
        <span class="delta down">▲ 0.6 min vs last week</span>
      </div>

      <div class="card kpi" id="kpi4">
        <span class="label">Open Alerts</span>
        <span class="value">7</span>
        <span class="delta down">2 critical · 3 warning · 2 info</span>
      </div>

      <!-- ROUTE STATUS BOARD -->
      <div class="card" id="routes">
        <div class="card-head">
          <h2>Line Status Board</h2>
          <span class="card-sub">Updated 12s ago</span>
        </div>
        <table class="route-table">
          <thead>
            <tr>
              <th>Line</th><th>Status</th><th>Delay</th><th>Next Arrival</th><th>Vehicles</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td data-label="Line"><span class="line-chip">12</span> Harbor Express</td>
              <td data-label="Status"><span class="status-dot ontime">On time</span></td>
              <td data-label="Delay" class="mono">0 min</td>
              <td data-label="Next Arrival" class="mono">4 min</td>
              <td data-label="Vehicles" class="mono">8 / 8</td>
            </tr>
            <tr>
              <td data-label="Line"><span class="line-chip">4</span> Crosstown</td>
              <td data-label="Status"><span class="status-dot delayed">Delayed</span></td>
              <td data-label="Delay" class="mono">6 min</td>
              <td data-label="Next Arrival" class="mono">11 min</td>
              <td data-label="Vehicles" class="mono">5 / 6</td>
            </tr>
            <tr>
              <td data-label="Line"><span class="line-chip">9</span> University Loop</td>
              <td data-label="Status"><span class="status-dot ontime">On time</span></td>
              <td data-label="Delay" class="mono">1 min</td>
              <td data-label="Next Arrival" class="mono">2 min</td>
              <td data-label="Vehicles" class="mono">6 / 6</td>
            </tr>
            <tr>
              <td data-label="Line"><span class="line-chip">21</span> Riverside</td>
              <td data-label="Status"><span class="status-dot delayed">Delayed</span></td>
              <td data-label="Delay" class="mono">9 min</td>
              <td data-label="Next Arrival" class="mono">14 min</td>
              <td data-label="Vehicles" class="mono">3 / 4</td>
            </tr>
            <tr>
              <td data-label="Line"><span class="line-chip">7</span> Old Town Circulator</td>
              <td data-label="Status"><span class="status-dot ontime">On time</span></td>
              <td data-label="Delay" class="mono">0 min</td>
              <td data-label="Next Arrival" class="mono">6 min</td>
              <td data-label="Vehicles" class="mono">4 / 4</td>
            </tr>
            <tr>
              <td data-label="Line"><span class="line-chip">15</span> Airport Connector</td>
              <td data-label="Status"><span class="status-dot minor">Minor delay</span></td>
              <td data-label="Delay" class="mono">3 min</td>
              <td data-label="Next Arrival" class="mono">9 min</td>
              <td data-label="Vehicles" class="mono">5 / 5</td>
            </tr>
          </tbody>
