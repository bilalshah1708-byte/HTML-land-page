<script>
  // Live clock
  function tick(){
    const el = document.getElementById('clock');
    const now = new Date();
    el.textContent = now.toLocaleTimeString('en-US', { hour12:false });
  }
  tick();
  setInterval(tick, 1000);

  // Mobile nav label toggle
  document.querySelector('.nav-toggle')?.addEventListener('click', () => {
    document.querySelectorAll('.rail-label').forEach(l => {
      l.style.display = l.style.display === 'inline' ? 'none' : 'inline';
    });
  });

  // Generate fleet vehicle grid (150 tiles: 142 in-service, 6 maint, 2 out)
  const grid = document.getElementById('fleetGrid');
  const total = 150, maint = 6, out = 2;
  const cells = [];
  for (let i = 0; i < total; i++){
    if (i < maint) cells.push('maint');
    else if (i < maint + out) cells.push('out');
    else cells.push('in');
  }
  // simple shuffle for a natural scatter
  for (let i = cells.length - 1; i > 0; i--){
    const j = Math.floor(Math.random() * (i + 1));
    [cells[i], cells[j]] = [cells[j], cells[i]];
  }
  cells.forEach(state => {
    const d = document.createElement('div');
    d.className = 'veh' + (state === 'in' ? '' : ' ' + state);
    grid.appendChild(d);
  });
</script>

